PORT=3000

# SQL Server running from docker-compose.yml
DATABASE_URL="sqlserver://localhost:14331;database=NovelPlatform;user=sa;password=YourStrong@Passw0rd;encrypt=true;trustServerCertificate=true"
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES=7d

# Required only by upload-related services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=